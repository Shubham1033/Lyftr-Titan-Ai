# LLM API Keys (comma-separated, at least 2 keys)
# Key IDs will automatically be assigned as key_1, key_2, etc.
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# SQLite database location (mounted to Docker volume at /data)
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook (required for testing X-Simulate-Failure)
ENABLE_FAILURE_SIMULATION=true

# Model to use
DEFAULT_MODEL=gemini/gemini-2.0-flash
