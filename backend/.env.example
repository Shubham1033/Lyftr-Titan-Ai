# LLM API Keys (comma-separated, at least 2 keys)
# For Gemini: gemini_api_key_1,gemini_api_key_2
LLM_API_KEYS=dummy_key_1,dummy_key_2

# SQLite database location (use sqlite:////data/app.db in Docker)
DATABASE_URL=sqlite:///./app.db

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook (X-Simulate-Failure header)
ENABLE_FAILURE_SIMULATION=true

# Default model name
DEFAULT_MODEL=gemini/gemini-2.0-flash
